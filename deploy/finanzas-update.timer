[Unit]
Description=Ejecuta el agente de actualizacion MAAT Finanzas cada minuto

[Timer]
# Respaldo + latido. El disparo instantaneo lo hace finanzas-update.path (inotify);
# el timer solo mantiene fresco el heartbeat y actua de red de seguridad.
OnBootSec=15s
OnUnitActiveSec=30s
AccuracySec=2s
Unit=finanzas-update.service

[Install]
WantedBy=timers.target
